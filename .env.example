# DocSumm — contoh environment variable. Salin ke .env.local untuk dev lokal.
# JANGAN commit .env.local (sudah di .gitignore). Nilai di sini HANYA
# contoh format — bukan kredensial asli.

# --- Supabase (opsional) ---
# Tanpa dua nilai ini aplikasi berjalan dalam MODE DEMO: tanpa akun,
# dokumen + template disimpan di localStorage. Lihat docs/DEMO.md.
# Isi dari Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- OpenRouter (opsional, hanya server) ---
# Tanpa kunci ini worker memakai ringkasan ekstraktif (tanpa AI).
# Di Pages, pasang sebagai SECRET (bukan variable biasa) — lihat
# docs/DEPLOYMENT.md. JANGAN taruh kunci di NEXT_PUBLIC_*.
OPENROUTER_API_KEY=

# URL publik aplikasi (dipakai sebagai HTTP-Referer ke OpenRouter).
NEXT_PUBLIC_APP_URL=http://localhost:3000
